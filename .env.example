# Copy to .env.local for development. The defaults work locally with no Cloudflare setup.

# Public base URL, e.g. https://lost.miralomasf.com
APP_URL=http://localhost:3000

# "local" (default): the bucket's files under ./.data/bucket on this machine.
# "r2": the Cloudflare R2 bucket. Requires the R2_* values below.
# A production build refuses "local" (it would write to the serverless disk and lose everything)
# unless ALLOW_LOCAL_STORAGE_IN_PRODUCTION=1, which is only for trying `next start` on a laptop.
STORAGE=local

# Shown wherever someone needs a person: "Questions? Email …".
CONTACT_EMAIL=lostandfound@miralomasf.com

# The first admin code. Copied to settings.json the first time the app runs; after that,
# admins change it on the Settings page and this value is ignored.
INITIAL_ADMIN_CODE=

# --- Cloudflare R2 (STORAGE=r2, and `npm run check:r2`) ---
# From the Cloudflare dashboard: the account ID, and an R2 API token with
# "Object Read & Write" on the miraloma-pta-lost-and-found bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=miraloma-pta-lost-and-found
